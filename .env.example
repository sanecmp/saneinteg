# Local development and integration checks only; never use these settings in production.
# run.py supplies isolated state paths and selects PYTHON_ENV for each command.
SANEA_SECRET_KEY=integration-only-secret-key
SANEA_ALLOWED_HOSTS=["localhost", "127.0.0.1", "[::1]", "testserver"]
SANEA_SERVER_HOST=127.0.0.1
SANEA_HTTP_PORT=18000
SANEA_HTTPS_PORT=18443
# This must match sanex's discovery port.
SANEA_DISCOVERY_PORT=62117

# Optional parent directories for retained runs (relative to the repository or absolute).
# SANECMP_DEVELOPMENT_STATE_DIR=.state/development
# SANECMP_INTEGRATION_STATE_DIR=.state/integration
